<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_bg_white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/rounded_bg_white">

            <TextView
                android:id="@+id/tvPlaceTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Place Title"
                android:textColor="#333333"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvPlaceAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Full address and description go here"
                android:textColor="#666666"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/btnViewRoute"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="View Route on Map"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#2196F3"
                app:cornerRadius="26dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnCheckFare"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Check Fare"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#4CAF50"
                app:cornerRadius="26dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnCloseModal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Close"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="@color/parada_red"
                app:cornerRadius="26dp" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>